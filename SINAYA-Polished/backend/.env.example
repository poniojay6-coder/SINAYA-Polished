PORT=3030
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional legacy satellite diagnostic only; not part of the sensor + weather MVP.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_CATALOG_URL=https://sh.dataspace.copernicus.eu/catalog/v1
COPERNICUS_PROCESS_URL=https://sh.dataspace.copernicus.eu/process/v1

# Planned SINAYA backend configuration
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Supabase Auth verifies each Bearer token; no service-role key is used for login.
SUPABASE_SERVICE_ROLE_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
SMS_SIMULATION_ONLY=true
